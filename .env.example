# MongoDB connection string. docker-compose.yml runs a local single-node
# replica set on this port. Transactions (used by checkout) require Mongo
# to be a replica set even for a single node — after the first
# `docker compose up -d`, run the one-time init command from the README
# before anything that touches checkout will work.
MONGODB_URI="mongodb://localhost:27017/bloom-beauty?replicaSet=rs0&directConnection=true"

# Any long random string — used to sign session JWTs. Generate one with:
# openssl rand -base64 32
JWT_SECRET="jDYfdZzgC12JLPt4NxZu+sRirVGm/Ba/EXNZLOhdFPQ="
